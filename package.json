{
  "name": "insightflow-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backend:dev": "cd backend && ./venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
    "backend:prod": "cd backend && ./venv/bin/gunicorn main:app --config gunicorn_conf.py --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000",
    "test": "npm run test:unit && npm run test:sit && npm run test:uat",
    "test:unit": "node --test tests/unit_frontend.test.mjs && ./backend/venv/bin/python3 -m unittest backend/tests/test_unit.py -v",
    "test:sit": "./backend/venv/bin/python3 -m unittest backend/tests/test_sit.py -v",
    "test:uat": "node --test tests/uat_scenarios.test.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "chart.js": "^4.5.1",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
